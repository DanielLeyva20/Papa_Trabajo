# Copie este archivo como backend/.env y complételo.

# development en la PC; production en Render
NODE_ENV=development

# PIN de 6 dígitos para entrar al sistema
APP_PIN=000000

# Clave larga y secreta para firmar la sesión (mínimo 32 caracteres).
# Genere una con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Base de datos. Sin DATABASE_URL se usa el archivo local datos/rol-turnos.db.
# Turso:  turso db show rol-turnos --url   /   turso db tokens create rol-turnos
# DATABASE_URL=libsql://rol-turnos-<usuario>.turso.io
# DATABASE_AUTH_TOKEN=

# Opcional: puerto (Render lo define solo)
# PORT=4800
