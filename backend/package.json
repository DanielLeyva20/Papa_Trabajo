{
  "name": "rol-turnos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API local del Rol de Turnos – Distrito Fiscal de Cañete",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
