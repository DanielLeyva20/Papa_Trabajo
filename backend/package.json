    "helmet": "^8.1.0",
    "pdfkit": "^0.17.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
